{
  "name": "axpm-ai-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:reset": "lsof -tiTCP:3000 | xargs kill -9 2>/dev/null; rm -rf .next && next dev",
    "fix": "npm run dev:reset",
    "build": "lsof -tiTCP:3000 | xargs kill -9 2>/dev/null; next build",
    "start": "next start",
    "start:prod": "next start",
    "system": "bash scripts/run-system.sh",
    "system:stop": "bash scripts/stop-system.sh",
    "system:upgrade": "bash scripts/upgrade-system.sh",
    "openclaw:start": "bash scripts/start-openclaw.sh",
    "cron:tick": "bash scripts/cron-tick.sh",
    "automation:install": "bash scripts/install-automation.sh",
    "handover:export": "bash scripts/handover-export.sh",
    "lint": "next lint"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "clsx": "^2.1.1",
    "edge-tts-universal": "^1.4.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "next": "^15.3.3",
    "nodemailer": "^8.0.10",
    "openai": "^4.103.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.0",
    "undici": "^8.3.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
