# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / Claude (optional if using DeepSeek)
OPENAI_API_KEY=
# If api.openai.com is blocked, use a compatible relay (OpenAI-format API):
# OPENAI_BASE_URL=https://your-relay.example.com/v1
# VPN (Clash/Surge): Node.js needs local proxy — pick your app's HTTP port:
OPENAI_PROXY=http://127.0.0.1:7890
# Or: HTTPS_PROXY=http://127.0.0.1:7890

# DeepSeek — works in China AND Malaysia (global API, no China VPN needed)
# Get key: https://platform.deepseek.com
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Malaysia: leave OPENAI_PROXY empty or commented when using DeepSeek only
# China + OpenAI only: use OPENAI_PROXY for Clash — DeepSeek ignores proxy automatically

ANTHROPIC_API_KEY=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily XAUUSD signal → Telegram (with npm run automation:install, 9:00 AM)
# GOLD_DAILY_TELEGRAM=1
# GOLD_DAILY_LOCALE=zh
# GOLD_DAILY_TIMEFRAME=M15–H1
# GOLD_DAILY_TIMEZONE=Asia/Hong_Kong

# Daily BTCUSD signal → Telegram (same cron as gold)
# BTC_DAILY_TELEGRAM=1
# BTC_DAILY_LOCALE=zh
# BTC_DAILY_TIMEFRAME=M15–H1
# BTC_DAILY_TIMEZONE=Asia/Hong_Kong

# Daily ETHUSD signal → Telegram (same cron as gold/btc)
# ETH_DAILY_TELEGRAM=1
# ETH_DAILY_LOCALE=zh
# ETH_DAILY_TIMEFRAME=M15–H1
# ETH_DAILY_TIMEZONE=Asia/Hong_Kong

# Signal profit / R:R policy (TP multiples of risk)
# SIGNAL_MIN_RR_TP1=2
# SIGNAL_MIN_RR_TP2=3

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Your mobile number to receive personal alerts (to-dos, etc.)
WHATSAPP_NOTIFY_PHONE=

# WeChat Work (企业微信) — auto-record incoming client messages
WECHAT_WORK_CORP_ID=
WECHAT_WORK_SECRET=
WECHAT_WORK_TOKEN=
# Employee userid (成员账号) who owns the external contact — required to send messages
WECHAT_WORK_SENDER_USERID=

# Optional: protect /api/digest/daily for cron jobs (leave empty for local use)
CRON_SECRET=

# Email SMTP — Gmail: smtp.gmail.com:587, use App Password (not login password)
# Create at https://myaccount.google.com/apppasswords (2FA required)
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Signal Flag Operations
# Comma-separated fallback recipients if not set in Settings UI
EMAIL_RECIPIENTS=
# Optional custom SMTP (when provider = custom in Settings)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false

# Google Drive — auto-backup finance receipts (resit)
# Create a service account, share your Drive folder with its email, paste folder ID below
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or separate fields:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=

# OpenClaw AI gateway (optional — auto-reply via local agent)
# Install: npm install -g openclaw@latest && openclaw onboard
# Enable HTTP API: openclaw config set gateway.http.endpoints.chatCompletions.enabled true
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=openclaw/default
# auto | openclaw | openai — auto prefers OpenClaw when token is set
AI_REPLY_PROVIDER=auto

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL when live (Cloudflare tunnel or ECS):
# NEXT_PUBLIC_APP_URL=https://talent.kaydenchiew.com

# Login sessions (change in production)
AUTH_SECRET=

# Customer subscriptions (Stripe — optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PRO=

# Cloudflare Tunnel → https://talent.kaydenchiew.com
# CLOUDFLARE_TUNNEL_TOKEN=

# Website live-chat widget (embed on axpmprimecn.com)
WIDGET_ENABLED=true
WIDGET_ALLOWED_ORIGINS=https://www.axpmprimecn.com,https://axpmprimecn.com,http://localhost:3000

# MiniMax TTS — presenter video voice (https://platform.minimaxi.com)
MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-02-turbo
MINIMAX_VOICE_ID=male-qn-qingse
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
# Face photo physiognomy — cheap vision providers (auto-fallback order)
# ① SiliconFlow (China, cheap Qwen-VL): https://cloud.siliconflow.cn
# SILICONFLOW_API_KEY=
# SILICONFLOW_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
# ② OpenRouter (free models abroad): https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
# ③ Gemini free tier: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash
# FORTUNE_VISION_PROVIDER=gemini,openai,siliconflow,openrouter
# MINIMAX_VISION_MODEL=MiniMax-M3
# OPENAI_VISION_MODEL=gpt-4o-mini

# Market AI — document parsing (PPT / Excel text extraction)
# Free tier: https://unstructured.io — get API key from dashboard
UNSTRUCTURED_API_KEY=
# UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general
# UNSTRUCTURED_STRATEGY=fast

# Market AI — beautiful PPT generation (Gamma Pro+ required)
# Get key: https://developers.gamma.app
GAMMA_API_KEY=
# GAMMA_API_BASE_URL=https://public-api.gamma.app/v1.0
# GAMMA_NUM_CARDS=10

# Market AI — DALL-E slide images (uses OPENAI_API_KEY above)
# OPENAI_IMAGE_MODEL=dall-e-3

# ── Self-hosted mode (your own stack — no MiniMax/Gamma/DALL·E/Unstructured) ──
SELF_HOSTED_MODE=true
MARKET_FORCE_LOCAL=true
TTS_PRIORITY=edge
# Optional: protect resale APIs — clients send Authorization: Bearer YOUR_KEY
# Also used by ATAS / Bookmap gold-signal bridges: GET /api/gold-signals/atas
# LOCAL_API_KEY=

# Piper TTS (fully local voice — run: npm run install:piper)
# PIPER_BIN=data/piper/piper
# PIPER_MODEL=data/piper/zh_CN-huayan-medium.onnx

# Market AI — Web search (for IC Markets / competitor lookup)
# Tavily (recommended for AI): https://tavily.com — free tier available
TAVILY_API_KEY=
# Or Google via Serper (recommended if you prefer Google results): https://serper.dev
SERPER_API_KEY=
WEB_SEARCH_PROVIDER=serper
# WEB_SEARCH_AUTO=true
# WEB_SEARCH_MAX_RESULTS=5

# Meta (Facebook + Instagram) — https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# WeChat Official Account (微信公众号) — https://mp.weixin.qq.com
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=

# TikTok / Weibo / Douyin / Xiaohongshu (optional — after developer approval)
TIKTOK_ACCESS_TOKEN=
WEIBO_ACCESS_TOKEN=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=
# 小红书 Xiaohongshu — https://open.xiaohongshu.com
XHS_APP_KEY=
XHS_APP_SECRET=
XHS_ACCESS_TOKEN=
